# Скопируйте в .env и поправьте под себя: cp .env.example .env

# Папка этого компьютера, внутри которой выбираются папки для связок (устройство "local").
# Монтируется в контейнер по тому же пути
SYNC_LOCAL_ROOT=/home/user/test-sync

# Пользователь, от имени которого создаются файлы (узнать: id -u; id -g)
UID=1000
GID=1000

# Период фоновой синхронизации ("1h", "30m", "off"); пусто — берётся из config.yml (по умолчанию 1h)
SYNC_INTERVAL=
