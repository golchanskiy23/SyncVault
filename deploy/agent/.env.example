# Уникальное имя этого устройства в сети синхронизации
AGENT_ID=home-server
# Базовая папка на этом устройстве: связки создаются для её подпапок (выбираются с сервера)
AGENT_DATA_DIR=/home/user
# Адрес ноутбука с сервером SyncVault (IP в локальной сети или в Tailscale) и порт
AGENT_SERVER=192.168.1.10:8081
# sync.agentToken из internal/config/config.yml на ноутбуке
AGENT_TOKEN=
# Порт агента (должен быть доступен с ноутбука)
AGENT_PORT=9100
# Адрес, по которому сервер ходит к агенту. Пусто — сервер возьмёт IP, с которого пришёл агент.
# Для Tailscale: http://<tailscale-ip-этого-устройства>:9100
AGENT_ADVERTISE=
# Владелец создаваемых файлов (id -u; id -g)
UID=1000
GID=1000
